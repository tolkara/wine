#
# The syscall dispatcher copies the caller's stack arguments as the Windows
# ABI lays them out: one 8-byte slot each. Apple's arm64 ABI packs stack
# arguments at their natural alignment, so a function that takes a ULONG as
# its tenth argument looks for it four bytes into the ninth argument's slot.
# These wrappers take every stack argument as ULONG_PTR and forward it with
# the type the implementation expects.

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REGISTER_ARGS = 8


def syscalls64():
    lines = (ROOT / 'dlls/ntdll/ntsyscalls.h').read_text().splitlines()
    # The 64-bit table: the ALL_SYSCALLS definition (not ALL_SYSCALLS32), up to
    # the first line without a continuation backslash.
    try: start = lines.index('#define ALL_SYSCALLS \\')
    except ValueError: sys.exit('make_darwin_syscalls: cannot find the 64-bit syscall table')
    block = []
    for line in lines[start + 1:]:
        block.append(line)
        if not line.endswith('\\'): break
    for m in re.finditer(r'SYSCALL_ENTRY\(\s*0x[0-9a-f]+,\s*(\w+),\s*(\d+)\s*\)', '\n'.join(block)):
        yield m.group(1), int(m.group(2))


def prototype(name):
    text = (ROOT / 'include/winternl.h').read_text()
    m = re.search(r'\bWINAPI\s+%s\((.*?)\);' % re.escape(name), text, re.S)
    if not m: sys.exit(f'make_darwin_syscalls: no prototype for {name} in include/winternl.h')
    return [' '.join(a.split()) for a in m.group(1).split(',')]


def main():
    out = ['/* Automatically generated by tools/make_darwin_syscalls; DO NOT EDIT! */', '']
    names = []
    for name, nbytes in syscalls64():
        if nbytes <= REGISTER_ARGS * 8: continue
        types = prototype(name)
        params, args = [], []
        for i, t in enumerate(types, 1):
            if i > REGISTER_ARGS:
                params.append(f'ULONG_PTR a{i}')
                args.append(f'({t})a{i}')
            else:
                params.append(f'{t} a{i}')
                args.append(f'a{i}')
        out.append(f'static NTSTATUS darwin_{name}( {", ".join(params)} )')
        out.append('{')
        out.append(f'    return {name}( {", ".join(args)} );')
        out.append('}')
        out.append('')
        names.append(name)
    out.append('static const struct { const char *name; void *func; } darwin_syscall_wrappers[] =')
    out.append('{')
    for name in names: out.append(f'    {{ "{name}", darwin_{name} }},')
    out.append('};')
    (ROOT / 'dlls/ntdll/unix/syscall_darwin.h').write_text('\n'.join(out) + '\n')
    print(f'dlls/ntdll/unix/syscall_darwin.h: {len(names)} wrappers')


if __name__ == '__main__': main()
